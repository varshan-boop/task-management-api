{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "uv run --project ../.. uvicorn main:app --host 0.0.0.0 --port ${PORT:-8080} --reload --reload-dir .",
    "start": "uv run --project ../.. uvicorn main:app --host 0.0.0.0 --port ${PORT:-8080}",
    "build": "uv run --project ../.. python -m compileall -q .",
    "typecheck": "uv run --project ../.. python -m compileall -q ."
  }
}
